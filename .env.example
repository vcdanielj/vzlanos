# Postgres (Coolify lo inyecta en prod)
DATABASE_URL=postgres://emergencia:emergencia@localhost:5432/emergencia

# Token simple para rescatistas (mutar estado de reportes). Cambiar en prod.
RESCUER_TOKEN=cambia-esto-en-produccion

# Puerto del servidor (Coolify suele inyectar PORT)
PORT=3000

# Email de contacto para el User-Agent de Nominatim (requisito de uso de OSM)
NOMINATIM_EMAIL=contacto@example.com
